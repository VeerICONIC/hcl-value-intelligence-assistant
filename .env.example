# Copy to .env (git-ignored) and adjust. NON-SECRET settings only.
# Never put AWS keys here: credentials come from the boto3 default chain
# (e.g. `aws login` / `aws sso login --profile <name>`, or an IAM role).

# --- AWS / Bedrock (D2) --------------------------------------------------
AWS_REGION=ap-south-1
# Optional named profile (SSO or shared credentials file). Blank = default chain.
AWS_PROFILE=
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0
# Titan V2 supports 256, 512 or 1024. Fixed once indexed; changing it means re-indexing.
BEDROCK_EMBED_DIM=1024
# APAC cross-region inference profile for Nova Lite
BEDROCK_LLM_MODEL_ID=apac.amazon.nova-lite-v1:0
LLM_MAX_TOKENS=800
LLM_TEMPERATURE=0.0
# Concurrent Titan requests per batch (Titan has no native batch API)
EMBEDDING_BATCH_SIZE=8

# --- Vector store (D3) ---------------------------------------------------
CHROMA_PATH=data/chroma
# Final collection name = <prefix>__<model>__<dim>, e.g. charters__titan-embed-text-v2__1024
CHROMA_COLLECTION_PREFIX=charters

# --- Paths ---------------------------------------------------------------
CONFIG_DIR=config
RAW_DATA_DIR=data/raw
CHARTERS_DIR=data/charters
PROCESSED_DIR=data/processed
ANSWER_KEY_DIR=data/answer_key

# --- API / dashboard (D13: the dashboard talks only to this API) ---------
API_BASE_URL=http://localhost:8000
LOG_LEVEL=INFO

# bedrock = Titan retrieval + Nova answers; extractive = offline (BM25 + cited excerpts, no AWS calls)
LLM_MODE=bedrock

# --- Nimbus web app (nimbus/) settings -------------------------------------
# Profile created with `aws login --profile hcl-rag` (needs boto3[crt]); leave AWS_PROFILE blank for the default chain.
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
CHROMA_PERSIST_DIRECTORY=data/chroma
# auto = use Bedrock when reachable, otherwise fall back automatically (local embeddings / cited excerpts)
EMBED_MODE=auto
